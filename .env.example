# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js
AUTH_SECRET=secret-to-change-with-a-real-secret
AUTH_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://culturando:culturando@127.0.0.1:5433/culturando

# Email verification
# Use EMAIL_PROVIDER=console in local development to print verification links in the server logs.
# Use EMAIL_PROVIDER=resend to send real transactional emails through Resend via SMTP.
EMAIL_PROVIDER=console
# SMTP_PORT=587 requires SMTP_SECURE=false.
# SMTP_PORT=465 requires SMTP_SECURE=true.
RESEND_API_KEY=""
SMTP_HOST="smtp.resend.com"
SMTP_PORT="465"
SMTP_USER="resend"
SMTP_PASSWORD="$RESEND_API_KEY"
SMTP_FROM="Culturando <noreply@culturando.app>"
SMTP_SECURE="true"

# Cloudflare R2 book cover storage
# If any required value is missing, the app falls back to local storage in apps/web/public/uploads/book-covers.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=

# Optional Cloudflare OCR Worker for assisted cataloging
CLOUDFLARE_OCR_ENDPOINT=
CLOUDFLARE_OCR_TOKEN=
CLOUDFLARE_OCR_MOCK_TEXT=

# Optional Geoapify geocoding/autocomplete provider
# If missing, the app falls back to Nominatim/OpenStreetMap.
GEOAPIFY_API_KEY=
